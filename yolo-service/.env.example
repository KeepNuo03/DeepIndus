# Backend strategy: auto | pytorch | onnx | tensorrt
YOLO_BACKEND=auto

# Device: 0 / cuda:0 / cpu
YOLO_DEVICE=0

# Model paths
YOLO_MODEL_PT_PATH=models/best.pt
YOLO_MODEL_ONNX_PATH=models/best.onnx
YOLO_MODEL_ENGINE_PATH=models/best.engine

# Inference params
YOLO_CONF_THRESHOLD=0.2
YOLO_IOU_THRESHOLD=0.45
YOLO_MAX_DET=300
YOLO_IMGSZ=640

# Perf / behavior
YOLO_USE_FP16=true
YOLO_WARMUP=true
YOLO_INCLUDE_ANNOTATED=true
YOLO_VERBOSE=false
YOLO_BACKEND_FALLBACK=true
